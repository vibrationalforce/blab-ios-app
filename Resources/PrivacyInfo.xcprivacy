<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ============================= -->
    <!-- PRIVACY TRACKING               -->
    <!-- ============================= -->

    <key>NSPrivacyTracking</key>
    <false/>

    <key>NSPrivacyTrackingDomains</key>
    <array>
        <!-- No tracking domains -->
    </array>

    <!-- ============================= -->
    <!-- DATA COLLECTION                -->
    <!-- ============================= -->

    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <!-- EMPTY on purpose (aligned 2026-07-16 with the ASC privacy label
             "Data Not Collected"): under Apple's definition, "collected" means
             transmitted off-device in a way accessible to the developer or
             partners — which never happens. There are no accounts, no analytics
             SDKs, no crash reporters, no server. Health/bio and audio data are
             processed on-device only; HealthKit-sourced values NEVER leave the
             device (BioEgressPolicy gates the OSC/ADM senders), and the only
             network egress (OSC/ADM/Art-Net/sACN of the app's own camera/BLE
             measurements) is user-initiated to devices the USER chooses — it is
             never available to Echoel. -->
    </array>

    <!-- ============================= -->
    <!-- API ACCESS                     -->
    <!-- ============================= -->

    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!-- User Defaults API -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>

            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>  <!-- App preference storage -->
                <string>1C8F.1</string>  <!-- App-Group suite shared with own
                                              extensions (BioFeedbackManager:
                                              group.com.echoelmusic → widget/AUv3) -->
            </array>
        </dict>

        <!-- File Timestamp API -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>

            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>  <!-- Accessing files created by user -->
                <string>0A2A.1</string>  <!-- Session data timestamps -->
            </array>
        </dict>

        <!-- System Boot Time API -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategorySystemBootTime</string>

            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>35F9.1</string>  <!-- Performance measurement -->
            </array>
        </dict>

        <!-- Disk Space API -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryDiskSpace</string>

            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>E174.1</string>  <!-- Display storage UI -->
                <string>85F4.1</string>  <!-- Write audio/video files -->
            </array>
        </dict>
    </array>
</dict>
</plist>
