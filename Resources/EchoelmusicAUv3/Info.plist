<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>EchoelmusicAUv3</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- AudioComponents kept BYTE-IDENTICAL to the project.yml `info:` block
	     (task #32, audit 2026-07-16): XcodeGen REGENERATES this file from
	     project.yml on every `xcodegen generate`, so project.yml is the source
	     of truth for what ships in host DAWs — this committed copy exists so
	     git shows the real shipping values. Change BOTH places or neither.
	     Component identity (type/subtype/manufacturer/version) must never
	     drift: hosts key persisted sessions on it. -->
	<!-- REGISTRATION LAW (device log 2026-07-16, build 2382: "ownAUv3 false"):
	     AudioComponents MUST live under NSExtension → NSExtensionAttributes —
	     iOS's pluginkit only registers audio components found there. It sat
	     directly under NSExtension before, so the extension was embedded but
	     NEVER registered (invisible to every host incl. our own scan). -->
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.AudioUnit-UI</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).AudioUnitViewController</string>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>AudioComponents</key>
			<array>
				<dict>
					<key>name</key>
					<string>Echoelmusic: EchoelBodyVibe</string>
					<key>description</key>
					<string>Bio-reactive performance synthesizer</string>
					<key>manufacturer</key>
					<string>Echo</string>
					<key>type</key>
					<string>augn</string>
					<key>subtype</key>
					<string>echl</string>
					<key>version</key>
					<integer>10000</integer>
					<key>sandboxSafe</key>
					<true/>
					<key>tags</key>
					<array>
						<string>Generator</string>
						<string>Ambient</string>
					</array>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
