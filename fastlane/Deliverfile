# =============================================================================
# ECHOELMUSIC — FASTLANE DELIVERFILE
# =============================================================================
# App Store Connect metadata configuration. Used only by the
# `upload_screenshots` lane (upload_to_app_store) — the screenshots pipeline
# is currently broken upstream (see fastlane/Pluginfile note), so this file is
# effectively dormant until that repair. CAUTION when reviving: with
# skip_metadata false and an EMPTY fastlane/metadata/ directory, verify deliver
# does not clobber live App Store Connect metadata before running for real.
# =============================================================================

# App Store Connect App Identifier
app_identifier "com.echoelmusic.app"

# Apple ID of the app (from App Store Connect)
apple_id "6757957358"

# App SKU (Stock Keeping Unit) - unique identifier in App Store Connect
app_sku "Simsalabimbam"

# Team ID for signing
team_id ENV["APPLE_TEAM_ID"]

# App Store Connect Team ID
itc_team_id ENV["APPLE_TEAM_ID"]

# =============================================================================
# METADATA CONFIGURATION
# =============================================================================

# false = deliver DOES upload metadata from fastlane/metadata/ (currently an
# empty directory — see the caution in the header before reviving this).
skip_metadata false

# Skip binary upload (handled by TestFlight lanes)
skip_binary_upload false

# Skip automatic screenshot upload
skip_screenshots false

# Force overwrite all remote screenshots
overwrite_screenshots true

# App Store submission information
submit_for_review false
automatic_release false

# Phased release configuration
phased_release true

# =============================================================================
# PRICING & AVAILABILITY
# =============================================================================

# Price tier (0 = free)
price_tier 0

# Available in all territories
run_precheck_before_submit false

# =============================================================================
# APP PRIVACY
# =============================================================================

# App uses non-exempt encryption (NO - uses standard Apple APIs only)
# This is already set in Info.plist but can be configured here too

