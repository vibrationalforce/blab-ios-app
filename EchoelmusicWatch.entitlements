<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Groups (read live vitals shared by the iPhone via BioFeedbackManager) -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.echoelmusic</string>
	</array>
	<!-- HealthKit entitlement added in C7 when on-wrist HR streaming lands:
	     <key>com.apple.developer.healthkit</key><true/> -->
</dict>
</plist>
