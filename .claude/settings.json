{
  "$schema": "https://claude.ai/schema/settings.json",
  "project": {
    "name": "Echoelmusic",
    "description": "Bio-reactive audio-visual production suite",
    "version": "10000.2",
    "phase": "ULTIMATE RALPH WIGGUM LOOP MODE"
  },
  "safety": {
    "enabled": true,
    "rules": [
      {
        "pattern": "git reset --hard",
        "action": "block",
        "reason": "Protects uncommitted work and biometric test data"
      },
      {
        "pattern": "git push --force",
        "action": "block",
        "reason": "Production branch protection - use PRs"
      },
      {
        "pattern": "git push --force-with-lease",
        "action": "block",
        "reason": "Force push blocked - use regular push"
      },
      {
        "pattern": "git clean -f",
        "action": "block",
        "reason": "Protects untracked files from deletion"
      },
      {
        "pattern": "git checkout -- .",
        "action": "block",
        "reason": "Discards all uncommitted changes - use git stash instead"
      },
      {
        "pattern": "git branch -D",
        "action": "warn",
        "reason": "Force-deleting branch - confirm intent"
      },
      {
        "pattern": "rm -rf Sources/",
        "action": "block",
        "reason": "Core Swift source protection"
      },
      {
        "pattern": "rm -rf android/",
        "action": "block",
        "reason": "Android build protection"
      },
      {
        "pattern": "rm -rf Tests/",
        "action": "block",
        "reason": "Test suite protection (1060+ tests)"
      },
      {
        "pattern": "rm -rf docs/",
        "action": "block",
        "reason": "Website/WebApp protection"
      },
      {
        "pattern": "rm -rf .claude/",
        "action": "block",
        "reason": "Claude Code configuration protection"
      },
      {
        "pattern": "rm -rf memory/",
        "action": "block",
        "reason": "Persistent memory protection"
      },
      {
        "pattern": "DROP TABLE",
        "action": "block",
        "reason": "Database protection"
      },
      {
        "pattern": "DELETE FROM",
        "action": "warn",
        "reason": "Potential data loss - confirm intent"
      },
      {
        "pattern": "curl | sh",
        "action": "block",
        "reason": "Pipe-to-shell blocked - download and inspect first"
      },
      {
        "pattern": "curl | bash",
        "action": "block",
        "reason": "Pipe-to-shell blocked - download and inspect first"
      },
      {
        "pattern": "eval $(",
        "action": "warn",
        "reason": "Dynamic eval - verify command is safe"
      }
    ],
    "allowedDestructive": [
      "rm -rf build/",
      "rm -rf .build/",
      "rm -rf DerivedData/",
      "rm -rf node_modules/",
      "rm -rf dist/"
    ]
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50"
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(xcodebuild -list:*)",
      "Bash(xcodebuild -version:*)",
      "Bash(xcodegen:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(python3 -c:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"=== Echoel persistent memory (memory/) ===\"; cat memory/people.md memory/user.md memory/vision.md memory/project_knowledge.md memory/preferences.md 2>/dev/null; echo; echo \"=== memory/decisions.md — TAIL 400 of $(wc -l < memory/decisions.md) lines. NOT chronological (both ends carry 07-2x dates); the newest entry sits near the tail, so this slice is a heuristic, not a guarantee. Full file: cat memory/decisions.md ===\"; tail -n 400 memory/decisions.md 2>/dev/null; echo; echo \"=== memory/inspiration_intake.md — the gate (head 60) + newest entries (tail 120) of $(wc -l < memory/inspiration_intake.md) lines. Full file: cat memory/inspiration_intake.md ===\"; head -n 60 memory/inspiration_intake.md 2>/dev/null; echo \"  [ ... middle withheld — see the command above ... ]\"; tail -n 120 memory/inspiration_intake.md 2>/dev/null; echo; echo '=== recent session log ==='; sed -n '1,80p' scratchpads/SESSION_LOG.md 2>/dev/null; echo; echo '=== THE COUNCIL (always-on, optimized) ==='; echo 'Before any SIGNIFICANT or hard-to-reverse decision (architecture, scope, >1 file, audio thread / protected Rausch triad, public copy, ambiguous founder ask, deploy/delete/publish), convene The Council: invoke the the-council skill (.claude/skills/the-council/SKILL.md). Seats give one-line position + sharpest concern, dissent is surfaced, synthesize ONE next step + a gate (proceed / mitigate / hold-for-founder). SKIP trivial reversible actions — convening on trivia is the failure mode. Composes with vision-gate + the Ralph Wiggum loop.'"
          }
        ]
      }
    ]
  },
  "workflow": {
    "branchPrefix": "claude/",
    "commitStyle": "conventional",
    "prRequired": true,
    "testBeforeCommit": true,
    "lintBeforeCommit": false
  },
  "context": {
    "maxTokens": 200000,
    "forkOnComplexTasks": true,
    "preserveAcrossSessions": [
      "architecture-decisions",
      "phase-progress",
      "known-issues"
    ]
  },
  "platforms": {
    "primary": ["iOS", "macOS", "visionOS"],
    "secondary": ["Android", "Windows", "Linux"],
    "web": ["PWA", "WebApp"]
  },
  "engines": {
    "audio": ["AudioEngine", "SpatialAudioEngine", "LoopEngine"],
    "visual": ["PhotonicsVisualizationEngine", "CymaticsRenderer"],
    "biofeedback": ["HealthKitManager", "BioParameterMapper", "RealTimeHealthKitEngine"],
    "collaboration": ["CollaborationSyncEngine", "GroupCoherenceEngine"],
    "physiology": ["CircadianRhythmEngine", "EvidenceBasedHRVTraining", "BioModulator"],
    "production": ["StreamEngine", "VideoProcessingEngine", "CreativeStudioEngine"]
  }
}
