# =============================================================================
# ECHOELMUSIC — FASTLANE DELIVERFILE
# =============================================================================
# App Store Connect metadata configuration. Used only by the
# `upload_screenshots` lane (upload_to_app_store) — the screenshots pipeline
# is currently broken upstream (see fastlane/Pluginfile note), so this file is
# effectively dormant until that repair. CAUTION when reviving: the real hazard
# is the OPPOSITE of what this note used to warn about — fastlane/metadata/ is
# NOT empty, so with skip_metadata false `deliver` OVERWRITES live App Store
# Connect copy with whatever is checked in. Read those files first and confirm
# they describe what actually ships (they claimed an AUv3 plugin for a month
# after the target was deleted).
#
# ⛔ AND "DORMANT" WAS THE PREMISE THAT MADE THIS FILE DANGEROUS (#633). Dormancy is a
# property of the LANE, not of this file: `deliver` invoked directly reads these settings
# with no lane in between, and the founder is doing submission work — which is exactly when
# someone types `fastlane deliver`. The screenshot pair below is now safe by default; the
# metadata pair deliberately is NOT, because uploading the checked-in copy is the intended
# use of this file and that copy is reviewed (#184). Losing the remote SCREENSHOTS is the
# only irreversible action in the whole submission path, so only that one is defaulted shut.
# =============================================================================

# App Store Connect App Identifier
app_identifier "com.echoelmusic.app"

# Apple ID of the app (from App Store Connect)
apple_id "6757957358"

# App SKU (Stock Keeping Unit) - unique identifier in App Store Connect
app_sku "Simsalabimbam"

# Team ID for signing
team_id ENV["APPLE_TEAM_ID"]

# App Store Connect Team ID
itc_team_id ENV["APPLE_TEAM_ID"]

# =============================================================================
# METADATA CONFIGURATION
# =============================================================================

# false = deliver DOES upload metadata from fastlane/metadata/.
# ⚠️ That directory is NOT empty — it holds the live App Store copy for en-US and
# de-DE (8 files each). With skip_metadata false, `deliver` OVERWRITES the live
# listing with whatever is in this repo. The "currently an empty directory"
# parenthetical that stood here was false and contradicted this file's own header.
skip_metadata false

# Skip binary upload (handled by TestFlight lanes)
skip_binary_upload false

# ⛔ THESE TWO WERE `false` / `true` UNTIL #633, AND TOGETHER THEY MEANT
# "DELETE EVERY LIVE APP STORE SCREENSHOT AND UPLOAD NOTHING IN THEIR PLACE".
# `git ls-files fastlane/screenshots` returns exactly ONE path and it is `.gitkeep` —
# the directory is empty. `overwrite_screenshots true` does not mean "replace"; it means
# remove-then-upload, and with nothing to upload the remote set is simply gone.
#
# It cannot be regenerated from this repo: all three capture lanes
# (fastlane/Fastfile:221, :236, :249) and fastlane/Snapfile:36 target a scheme named
# `EchoelmusicScreenshots`, and `project.yml`'s `schemes:` block declares only
# Echoelmusic, EchoelmusicFullTests, EchoelmusicWidgets and EchoelmusicWatch. There is no
# UI-test target anywhere in the repo. So the loss would be permanent.
#
# ⚠️ THE `upload_screenshots` LANE'S GUARD IS NOT ENOUGH, which is why this moved here
# rather than being left to it. `fastlane/Fastfile:265-267` disarms that ONE lane with an
# unconditional `UI.user_error!` — but a bare `fastlane deliver` typed at a terminal never
# enters a lane and reads these defaults directly. The safe state has to BE the default.
#
# Re-arm both in the SAME commit that adds real screenshot files, never before.
skip_screenshots true

# Force overwrite all remote screenshots (see the block above before touching this)
overwrite_screenshots false

# App Store submission information
submit_for_review false
automatic_release false

# Phased release configuration
phased_release true

# =============================================================================
# PRICING & AVAILABILITY
# =============================================================================

# Price tier (0 = free)
price_tier 0

# Available in all territories
run_precheck_before_submit false

