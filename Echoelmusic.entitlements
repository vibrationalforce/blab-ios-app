<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- HealthKit Access (bio-reactive features — LIVE: HealthKitBioPublisher) -->
	<key>com.apple.developer.healthkit</key>
	<true/>

	<!-- iCloud / CloudKit — ENABLED 2026-07-10 (founder: container + push +
	     WeatherKit registered in the developer portal). Verification = the
	     v10.79.141 TestFlight archive (automatic signing validates these).
	     Used by E4 (CloudKit public-DB Announcements → push, no account). -->
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.echoelmusic.app</string>
	</array>

	<!-- Push (aps) — delivery channel for the CloudKit Announcement
	     subscriptions (E4). Opt-in in-app; no server of our own. -->
	<key>aps-environment</key>
	<string>production</string>

	<!-- WeatherKit — one coarse fetch per session start feeds the
	     weather→composition mapping (E3b, Core/WeatherMood.swift). -->
	<key>com.apple.developer.weatherkit</key>
	<true/>

	<!-- App Groups (shared data with extensions — the REAL sharing channel:
	     BioFeedbackManager App-Group UserDefaults). keychain-access-groups was
	     REMOVED 2026-07-16 (audit): zero keychain API usage anywhere in Sources,
	     no extension declared the group either, and the "Notification Service"
	     the old comment named does not exist — a declared-but-unused entitlement
	     only invites capability questions. Re-add when code actually stores
	     keychain items. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.echoelmusic</string>
	</array>
</dict>
</plist>
