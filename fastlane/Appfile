end

# tvOS / visionOS upload lanes (unified bundle ID; no such targets in v10 —
# lanes exist because testflight.yml can dispatch those platform jobs)
for_lane :upload_tvos do
  app_identifier "com.echoelmusic.app"
end

for_lane :upload_visionos do
  app_identifier "com.echoelmusic.app"
end

